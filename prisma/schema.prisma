// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AmazonProduct {
  id               String   @id @default(cuid())
  asin             String   @unique
  title            String
  brand            String?
  category         String?
  description      String?
  featureBullets   String?
  price            Float?
  salePrice        Float?
  inStock          Boolean  @default(true)
  stockQuantity    Int?
  outOfStock       Boolean  @default(false)
  availabilityStatus String?
  cannotBeShipped Boolean  @default(false)
  shippingUnavailableReason String?
  shippingPrice    Float?
  primeEligible    Boolean  @default(false)
  mainImage        String?
  images           String?
  variants         String?
  rating           Float?
  ratingsTotal     Int?
  reviewsUpdatedAt DateTime?
  reviews          String?
  bestsellRank     Int?
  amazonUrl        String?
  shopifyProductId String?
  shopifyVariantId String?
  shopifyHandle    String?
  marginRate       Float    @default(30)
  shopifyPrice     Float?
  lastSyncedAt     DateTime?
  syncStatus       String   @default("pending")
  syncError        String?
  riskLevel        String   @default("safe")
  filterStatus     String   @default("ok")
  filterReason     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AppSettings {
  id                String   @id @default(cuid())
  shop              String   @unique
  defaultMargin     Float    @default(30)
  includeShipping   Boolean  @default(false)
  autoHideOutOfStock Boolean @default(true)
  addReviewsToDesc  Boolean  @default(true)
  autoGenerateTags  Boolean  @default(true)
  saleMode          String   @default("direct")
  addDisclaimer     Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BrandBlacklist {
  id        String   @id @default(cuid())
  brand     String   @unique
  riskLevel String   @default("high")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CategoryBlacklist {
  id        String   @id @default(cuid())
  category  String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model KeywordFilter {
  id        String   @id @default(cuid())
  keyword   String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SchedulerConfig {
  id         String    @id @default(cuid())
  shop       String    @unique
  schedule   String    @default("daily")
  enabled    Boolean   @default(false)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model UpdateLog {
  id        String   @id @default(cuid())
  shop      String?
  asin      String?
  action    String
  status    String
  message   String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

model OrderWebhookLog {
  id              String   @id @default(cuid())
  shop            String
  topic           String
  webhookId       String?  @unique
  shopifyOrderId  String
  status          String   @default("received")
  payload         String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop, shopifyOrderId])
}

model OrderQueueJob {
  id              String    @id @default(cuid())
  shop            String
  type            String
  status          String    @default("pending")
  shopifyOrderId  String
  provider        String    @default("zinc")
  payload         String?
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5)
  runAt           DateTime  @default(now())
  lockedAt        DateTime?
  completedAt     DateTime?
  lastError       String?
  retryHistory    String?
  failureReason   String?
  failureCategory String?
  dlqStatus       String?
  recoveryAttempts Int      @default(0)
  lastFailureAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([shop, type, shopifyOrderId])
  @@index([status, runAt])
  @@index([dlqStatus])
}

model DeadLetterQueueJob {
  id              String    @id @default(cuid())
  originalJobId   String    @unique
  shop            String
  type            String
  shopifyOrderId  String
  provider        String    @default("zinc")
  status          String    @default("open")
  originalPayload String?
  retryHistory    String?
  failureCategory String
  failureReason   String
  attempts        Int
  maxAttempts     Int
  recoveryAttempts Int      @default(0)
  recoveryNote    String?
  lastFailureAt   DateTime
  recoveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, lastFailureAt])
  @@index([shop, shopifyOrderId])
}

model MonitoringEvent {
  id              String   @id @default(cuid())
  eventType       String
  severity        String   @default("info")
  shop            String?
  jobType         String?
  workerName      String?
  provider        String?
  shopifyOrderId  String?
  durationMs      Int?
  count           Int?
  payload         String?
  createdAt       DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@index([shop, createdAt])
}

model AnalyticsSummary {
  id            String   @id @default(cuid())
  metricName    String
  bucketStart   DateTime
  bucketEnd     DateTime
  dimensionsKey String   @default("{}")
  dimensions    String?
  value         Float
  count         Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([metricName, bucketStart, dimensionsKey])
  @@index([metricName, bucketStart])
  @@index([bucketStart, bucketEnd])
}

model AnalyticsAggregationRun {
  id           String   @id @default(cuid())
  bucketStart  DateTime
  bucketEnd    DateTime
  status       String
  summaryCount Int      @default(0)
  durationMs   Int?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([bucketStart, bucketEnd])
  @@index([status, bucketEnd])
}

model ProviderOrder {
  id                String    @id @default(cuid())
  shop              String
  shopifyOrderId    String
  provider          String
  providerOrderId   String?
  status            String    @default("pending")
  requestPayload    String?
  responsePayload   String?
  trackingNumber    String?
  trackingCarrier   String?
  trackingUrl       String?
  trackingReceivedAt DateTime?
  fulfillmentSyncedAt DateTime?
  shopifyFulfillmentId String?
  processingLockedAt DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([shop, shopifyOrderId, provider])
  @@index([provider, providerOrderId])
  @@index([status, processingLockedAt])
}

model TrackingLog {
  id              String   @id @default(cuid())
  shop            String
  shopifyOrderId  String
  provider        String
  providerOrderId String
  trackingNumber  String
  carrier         String
  trackingUrl     String?
  status          String
  payload         String?
  createdAt       DateTime @default(now())

  @@unique([shop, shopifyOrderId, provider, trackingNumber, carrier])
  @@index([shop, shopifyOrderId])
}

model FulfillmentLog {
  id                 String   @id @default(cuid())
  shop               String
  shopifyOrderId     String
  provider           String
  providerOrderId    String?
  shopifyFulfillmentId String?
  trackingNumber     String
  carrier            String
  trackingUrl        String?
  status             String
  requestPayload     String?
  responsePayload    String?
  message            String?
  createdAt          DateTime @default(now())

  @@unique([shop, shopifyOrderId, provider, trackingNumber, carrier])
  @@index([shop, shopifyOrderId])
}

model AdminOrderAction {
  id             String   @id @default(cuid())
  shop           String
  orderId        String
  shopifyOrderId String
  actionType     String
  previousStatus String?
  newStatus      String?
  adminNote      String?
  actionPayload  String?
  createdBy      String?
  createdAt      DateTime @default(now())

  @@index([shop, shopifyOrderId])
  @@index([actionType])
  @@index([createdAt])
}
